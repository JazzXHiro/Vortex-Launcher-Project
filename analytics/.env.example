# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored; this template is committed.
#
# Everything here is OPTIONAL. Vortex runs without any of it: your Steam
# library, playtime tracking and recommendations all work with this file
# absent. The keys below add artwork and the Discover section.
#
# The launcher's first-run wizard writes this file for you. Editing it by
# hand is only necessary if you skipped the wizard or want to change a key.

# ---- IGDB / Twitch ----
# Used by the launcher (game metadata lookup) and by the candidate catalog
# fetcher: python igdb_catalog.py --refresh
# Create an application at https://dev.twitch.tv/console/apps
# The client secret is shown only once, at creation.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---- SteamGridDB ----
# Used by the launcher to download cover/hero/logo artwork.
# https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# ---- Advanced ----
# Where the analytics database lives. Defaults to vortex.sqlite3 beside these
# scripts, which is what the installer expects. There is no server, no port
# and no password: Vortex used PostgreSQL until v3 and moved to SQLite so the
# launcher could ship as a self-contained install.
# DB_PATH=
